# Pick ONE provider below, fill in your key, and save this file as .env

# --- Option 1: Google Gemini (Free tier available via Google AI Studio) ---
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash

# --- Option 2: xAI Grok (Requires API credits at console.x.ai) ---
# LLM_API_KEY=xai-your_key_here
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.7

# --- Option 3: OpenAI ---
# LLM_API_KEY=sk-your_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Option 4: Local Ollama (Free, runs on your machine) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
